# Run from the DocQuality project directory: doxygen Doxyfile
DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = DocQuality
PROJECT_BRIEF          = "Simulated documentation quality assessment in C++"
OUTPUT_DIRECTORY       = docs
OUTPUT_LANGUAGE        = English
INPUT                  = .
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h *.cpp *.md
RECURSIVE              = YES
EXCLUDE                = docs x64 Debug Release DocQuality
USE_MDFILE_AS_MAINPAGE = README.md
MARKDOWN_SUPPORT       = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
SOURCE_BROWSER         = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
HAVE_DOT               = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DOT_IMAGE_FORMAT       = svg
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_LOGFILE           = docs/doxygen-warnings.log
QUIET                  = YES
